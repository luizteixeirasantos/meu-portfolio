{
  "name": "luiz-portfolio-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Portfólio Full Stack Monorepo",
  "author": "Luiz",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}
